# Copy to .env and fill in real values locally. Never commit .env.

AWS_REGION=ap-south-1
PROOFPATH_TEST_PINCODE=110001

# Set once WP-01's checkpoint pins a model/voice.
PROOFPATH_BEDROCK_MODEL_ID=
PROOFPATH_POLLY_VOICE=

# Rotated server-only token between workflow tasks and the agent container.
PROOFPATH_AGENT_TOKEN=

# Cognito, set once WP-01/WP-03 deploy the auth skeleton.
PROOFPATH_COGNITO_USER_POOL_ID=
PROOFPATH_COGNITO_CLIENT_ID=

# Callback HMAC secret (simulator -> API), set once WP-09 exists.
PROOFPATH_CALLBACK_HMAC_SECRET=
