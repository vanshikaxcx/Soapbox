# Browser-safe development label only. Never put secrets in VITE_ variables.
VITE_PROOFPATH_MODE=local

# WP-03: typed API client base URL and Cognito PKCE config. WP-01 provisions
# the actual Cognito user pool/client; these are placeholders until then.
VITE_API_BASE_URL=https://api.example.invalid
VITE_COGNITO_DOMAIN=example.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-with-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPES=openid email
