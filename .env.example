# Safe local configuration template. Copy values to an untracked .env.local file.
# WP-00 defines names only; it does not read configuration or select adapters.
# Later composition roots may consume PROOFPATH_MODE; WP-00 does not assign its consumer.
PROOFPATH_MODE=local
# WP-01 introduces this AWS region setting through its server composition root.
PROOFPATH_AWS_REGION=ap-south-1
# Optional LocalStack validation is not part of ordinary setup or CI; it is deferred to WP-00 Gate A.
# LOCALSTACK_AUTH_TOKEN=
# P4's WP-10 callback ingestion introduces this server-only secret.
# PROOFPATH_CALLBACK_SECRET=
