# Keep Stage 2 repository-controlled text portable without rewriting historical sources.
/.editorconfig text eol=lf
/.env.example text eol=lf
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.node-version text eol=lf
/.python-version text eol=lf
/package.json text eol=lf
/pyproject.toml text eol=lf
/uv.lock text eol=lf
/uv.toml text eol=lf
/scripts/** text eol=lf
/web/** text eol=lf
/AGENTS.md text eol=lf
/CLAUDE.md text eol=lf
/LEARNING.md text eol=lf
/LICENSE text eol=lf
/README.md text eol=lf
/contracts/** text eol=lf
/docs/** text eol=lf
/guidance/** text eol=lf
/infra/** text eol=lf
/playwright.config.ts text eol=lf
/policies/** text eol=lf
/services/** text eol=lf
/tests/** text eol=lf
/workflows/** text eol=lf
/.github/** text eol=lf

# Binary assets must never be run through text/EOL normalization,
# even under a directory pattern above that marks text eol=lf.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
